# Vehicle Emission Prediction Project - Environment Configuration Example
# Copy this file to .env and modify as needed

# Data paths
# DATA_PATH=data/vehicle_emission_dataset.csv

# Model configuration
# TARGET_COLUMN=CO2 Emissions
# TEST_SIZE=0.2
# RANDOM_STATE=42
# CV_FOLDS=5

# Logging
# LOG_LEVEL=INFO
# LOG_FILE=logs/project.log

# Output directories
# FIGURES_DIR=outputs/figures
# MODELS_DIR=models
# REPORTS_DIR=reports
# OUTPUTS_DIR=outputs

# Future scenario defaults (override in scenario_config.json)
# BASE_YEAR=2024
# BASE_FLEET_SIZE=100000
# BASE_AVG_EMISSION=200.0