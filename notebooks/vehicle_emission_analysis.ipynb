    "## 19. Future-Year Scenario Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create scenario config template\n",
    "from future_scenarios import create_scenario_config_template\n",
    "create_scenario_config_template()\n",
    "\n",
    "# Load and modify\n",
    "import json\n",
    "with open('outputs/scenario_config_template.json') as f:\n",
    "    config_data = json.load(f)\n",
    "\n",
    "print(\"Scenario Configuration Template:\")\n",
    print(json.dumps(config_data, indent=2))\n",
    "\n",
    "# Now run scenarios\n",
    "from train import load_model\n",
    "pipeline = load_model()\n",
    "\n",
    "# Estimate base emission from model\n",
    "from future_scenarios import estimate_base_emission_from_model\n",
    "X_small = df_clean.head(10)\n",
    "X_prepared, _, _ = prepare_features_targets(X_small)\n",
    "base_emission, warning = estimate_base_emission_from_model(\n",
    "    pipeline, X_prepared, config.data.target_unit\n",
    ")\n",
    "\n",
    "if warning:\n",
    "    print(warning)\n",
    "\n",
    "print(f\"\\nBase average emission from model: {base_emission:.2f}\")\n",
    "\n",
    "# Run scenarios\n",
    "results = run_all_scenarios(\n",
    "    base_fleet=config.scenario.starting_fleet_size or 10000,\n",
    "    base_emission=base_emission,\n",
    "    years=config.scenario.future_years,\n",
    "    base_year=config.scenario.base_year\n",
    ")\n",
    "\n",
    "# Save\n",
    "from future_scenarios import save_scenarios\n",
    "save_scenarios(results)\n",
    "\n",
    "# Plot\n",
    "from visualization import plot_future_scenarios\n",
    "plot_future_scenarios(results)\n",
    "print('\\nFuture scenarios plot saved to outputs/figures/future_scenarios.png')\n",
    "\n",
    "# Print summary\n",
    "final_year = results['year'].max()\n",
    "print(f'\\nFinal year ({final_year}) summary:')\n",
    "for scenario in results['scenario'].unique():\n",
    "    subset = results[results['scenario'] == scenario]\n",
    "    final = subset[subset['year'] == final_year].iloc[0]\n",
    "    print(f'  {scenario}: fleet={final[\"fleet_size\"]:.0f}, '
    "avg={final['avg_emission_per_vehicle']:.2f}, "
    f"total={final['total_emissions']:.2f}')"
   ]
  },
