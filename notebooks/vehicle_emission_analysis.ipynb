    "## 15. Residual Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Residuals\n",
    "pipeline = load_model()\n",
    "y_pred = pipeline.predict(X_test)\n",
    "residuals = y_test.values - y_pred\n",
    "\n",
    "# Plot residuals distribution\n",
    "from evaluate import plot_residuals\n",
    "\n",
    "plot_residuals(\n",
    "    residuals,\n",
    "    title='Residual Distribution',\n",
    "    save_path='outputs/figures/residuals_distribution.png',\n    unit='dataset units'\n",
    ")\n",
    "print('Residual distribution plot saved')\n",
    "\n",
    "# Residuals vs predicted\n",
    "from evaluate import plot_residuals_vs_predicted\n",
    "\n",
    "plot_residuals_vs_predicted(\n",
    "    y_pred, residuals,\n",
    "    title='Residuals vs Predicted',\n",
    "    save_path='outputs/figures/residuals_vs_predicted.png',\n    unit='dataset units'\n",
    ")\n",
    "print('Residuals vs predicted plot saved')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 16. Feature Importance"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Permutation importance\n",
    "from evaluate import get_feature_importance, plot_feature_importance\n",
    "\n",
    "feature_imp = get_feature_importance(\n",
    "    pipeline, X_test, y_test, feature_names\n",
    ")\n",
    "\n",
    "if feature_imp is not None:\n",
    "    print(f\"Feature importance for {len(feature_imp)} features\")\n",
    "    # Print top 10\n",
    "    sorted_imp = sorted(feature_imp.items(), key=lambda x: x[1], reverse=True)[:10]\n",
    "    for feat, imp in sorted_imp:\n",
    "        print(f\"  {feat}: {imp:.4f}\")\n",
    "\n",
    "    # Plot\n",
    "    plot_feature_importance(\n",
    "        feature_imp,\n",
    "        top_n=20,\n",
    "        title='Permutation Feature Importance (Top 20)',\n",
    "        save_path='outputs/figures/feature_importance.png'\n    )\n",
    "    print('Feature importance plot saved')\n",
    "else:\n",
    "    print(\"Feature importance not supported for this model\")"
   ]
  },
